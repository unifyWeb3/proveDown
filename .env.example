# ProveDown — Environment Example (copy to .env.local and fill, never commit secrets)
# See CREDENTIALS-REQUIRED.md for where to obtain each value.

# --- GenLayer / Bradbury ---
# Bradbury Testnet RPC (public) — for deploy + frontend reads/writes
GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
GENLAYER_CHAIN_ID=4221
GENLAYER_NETWORK=testnetBradbury
GENLAYER_EXPLORER_URL=https://explorer-bradbury.genlayer.com
# Deployer private key (hex 0x... 32 bytes, funded via faucet) — NEVER commit
GENLAYER_PRIVATE_KEY=
# Deployed contract address (set after `npm run deploy:bradbury`)
NEXT_PUBLIC_PROVEDOWN_CONTRACT_ADDRESS=0x...
# Optional Studio / Asimov (for Studio test path)
GENLAYER_STUDIO_RPC=https://studio.genlayer.com/api
GENLAYER_STUDIO_CHAIN_ID=61999
# PRIMARY hackathon target: Studio Next (Consensus v0.6 RC, chain 61997)
GENLAYER_STUDIO_DEV_RPC=https://studio-dev.genlayer.com/api
GENLAYER_STUDIO_DEV_CHAIN_ID=61997
# Studio-dev contract address (set after studio-dev deploy with fees)
NEXT_PUBLIC_PROVEDOWN_CONTRACT_STUDIO_DEV=0x...

# --- Contract ---
# Fee profile for estimate-fees (low|standard|high)
GENLAYER_FEE_PRESET=standard

# --- Base Sepolia (for mock VerdictRegistry -> real bridge post-hackathon) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_PRIVATE_KEY=0xYOUR_BASE_PRIVATE_KEY_HERE
NEXT_PUBLIC_BASE_VERDICT_REGISTRY=0x...
NEXT_PUBLIC_BASE_EXPLORER_URL=https://sepolia.basescan.org

# --- Hyperlane (post-hackathon real bridge; mocked for hackathon) ---
# No credential needed for hackathon mock; for real: HYPERLANE_MAILBOX=...
HYPERLANE_MAILBOX=0x...

# --- Bundle Worker (stable preset endpoint for jury fetch) ---
# Deployed Worker URL — jury does gl.nondet.web.render(mode='text') to this
NEXT_PUBLIC_BUNDLE_WORKER_URL=https://provedown-bundle.your-subdomain.workers.dev/bundle
# Optional local fallback for dev
BUNDLE_WORKER_URL=http://localhost:8787/bundle

# --- Frontend (Next.js, like genlayer-jury) ---
NEXT_PUBLIC_GENLAYER_NETWORK=testnetBradbury
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-bradbury.genlayer.com
NEXT_PUBLIC_LIVE_JURY=false
NEXT_PUBLIC_BUNDLE_WORKER_URL=https://provedown-bundle.your-subdomain.workers.dev/bundle

# --- LLM / OpenRouter (only if validators need custom provider; Bradbury validators already have Heurist/Comput3/Chutes) ---
# Frontend does NOT call OpenRouter in live mode — validators do. Only needed for local mocked jury (NEXT_PUBLIC_LIVE_JURY=false)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=ProveDown

# --- Optional: Vercel / hosting ---
VERCEL_PROJECT_ID=
